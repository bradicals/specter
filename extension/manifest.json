{
  "manifest_version": 3,
  "name": "Specter Import",
  "version": "1.0",
  "description": "Import Axosoft tickets into Specter with one click.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://*.axosoft.com/*",
    "http://localhost:3333/*"
  ],
  "action": {
    "default_title": "Send to Specter",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  }
}
